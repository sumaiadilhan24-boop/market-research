# Supabase project credentials (Project Settings → API)
# Leave these empty to run SaleCat in built-in DEMO mode with sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copy this file to .env.local and fill in the values above.
# Then run `supabase/schema.sql` once in the Supabase SQL Editor.
