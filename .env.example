# Supabase project credentials (Project Settings → API)
# Leave these empty to run Market Research in local IndexedDB mode — the full
# app works and persists data in this browser without any backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copy this file to .env.local and fill in the values above.
# Then run `supabase/schema.sql` once in the Supabase SQL Editor.
